description     "NVIDIA bluetooth/wifi init script"
#
# L4T on Xiaomi Mi Pad 1 (mocha / Tegra K1) - Bluetooth bring-up
#
# WORKING CONFIGURATION (verified on hardware).
#
# 1) The stock script enabled low-power mode:
#        echo 1 > /proc/bluetooth/sleep/lpm
#        brcm_patchram_plus ... --enable_lpm --tosleep=50000 ...
#    The LPM wake path does not work on this board, so the BCM43341 went to
#    sleep and never answered another HCI command again -- every command,
#    including HCI Reset (0x0c03), timed out.
#
# 2) --patchram is NOT usable here: /lib/firmware/BCM4350C0.hcd targets a
#    different chip and brcm_patchram_plus hangs on it forever.  The patch is
#    not needed for normal operation.
#
# 3) The controller still boots with a placeholder address
#    43:50:C0:00:00:00, which makes inquiry responses unusable for other
#    devices (the tablet looks invisible).  bt-mac-setup.sh writes a real
#    BD_ADDR derived from the WiFi MAC, sets a sane Class of Device and
#    enables inquiry+page scan.
#
instance $SUBTASK

script
	exec /usr/sbin/rfkill unblock bluetooth
	exec /usr/sbin/brcm_patchram_plus --enable_hci --scopcm=0,2,0,0,0,0,0,0,0,0 --baudrate 115200 --no2bytes /dev/ttyTHS2
end script

post-start script
	/usr/local/sbin/bt-mac-setup.sh
end script
