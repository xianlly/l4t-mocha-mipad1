		partition-id = <0x16>;
	};

	mc {
		compatible = "nvidia,tegra-mc";
		reg-ranges = <0x09>;
		reg = <0x00 0x70019000 0x00 0x0c 0x00 0x70019050 0x00 0x19c 0x00 0x70019200 0x00 0x24 0x00 0x7001929c 0x00 0x1b8 0x00 0x70019464 0x00 0x198 0x00 0x70019604 0x00 0x3b0 0x00 0x700199bc 0x00 0x20 0x00 0x700199f8 0x00 0x8c 0x00 0x70019ab4 0x00 0x54c>;
		interrupts = <0x00 0x4d 0x04>;
		int_count = <0x08>;
		int_mask = <0x13d40>;
		channels = <0x01>;
		status = "okay";
	};

	pinmux@70000868 {
		compatible = "nvidia,tegra124-pinmux";
		reg = <0x00 0x70000868 0x00 0x164 0x00 0x70003000 0x00 0x434 0x00 0x70000820 0x00 0x08>;
		#gpio-range-cells = <0x03>;
		status = "okay";
		pinctrl-names = "default", "drive", "unused";
		pinctrl-0 = <0x04>;
		pinctrl-1 = <0x05>;
		pinctrl-2 = <0x06>;
		linux,phandle = <0x07>;
		phandle = <0x07>;

		prod-settings {
			#prod-cells = <0x04>;

			prod {
				status = "okay";
				nvidia,prod-boot-init;
				prod = <0x00 0x28 0xe0e0ff3 0x605008 0x00 0x2c 0xe0e0ff3 0x605008 0x00 0x30 0xe0e0ff3 0x605008 0x00 0x34 0xe0e0ff3 0x605008 0x00 0x130 0xe0e0ff3 0x605008 0x00 0x38 0xe0e0ff3 0x50500c 0x00 0x18 0xf003ff3 0x29400c 0x00 0xa8 0xf003ff3 0x29400c 0x00 0x94 0xe0e0ff3 0x50500c 0x00 0x00 0xe0e0ff3 0x50500c 0x00 0x58 0xe0e0ff3 0xf0000000 0x00 0x5c 0xe0e0ff3 0xf0000000 0x00 0x0c 0x8080f33 0x3f37000 0x00 0xbc 0xe0e0ff3 0xf1717000 0x00 0x50 0xe0e0ff3 0xf1717000>;
			};
		};

