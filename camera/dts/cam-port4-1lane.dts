	i2c@7000d100 {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		compatible = "nvidia,tegra124-i2c";
		reg = <0x00 0x7000d100 0x00 0x100>;
		interrupts = <0x00 0x3f 0x04>;
		iommus = <0x0e 0x0e>;
		status = "okay";
		clock-frequency = <0x61a80>;
	};

	spi@7000d400 {
		compatible = "nvidia,tegra124-spi";
		reg = <0x00 0x7000d400 0x00 0x200>;
		interrupts = <0x00 0x3b 0x04>;
		nvidia,dma-request-selector = <0x10 0x0f>;
		iommus = <0x0e 0x0e>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		clocks = <0x11 0x29>;
		status = "okay";
		dmas = <0x10 0x0f 0x10 0x0f>;
		dma-names = "rx", "tx";
		nvidia,clk-parents = "pll_p", "clk_m";
		spi-max-frequency = <0x17d7840>;
	};

	spi@7000d600 {
		compatible = "nvidia,tegra124-spi";
		reg = <0x00 0x7000d600 0x00 0x200>;
