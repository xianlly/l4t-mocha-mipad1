						regulator-max-microvolt = <0x155cc0>;
						regulator-always-on;
						regulator-boot-on;
						ti,roof-floor = <0x01>;
						ti,config-flags = <0x08>;
						linux,phandle = <0x81>;
						phandle = <0x81>;

						consumers {

							c1 {
								regulator-consumer-supply = "vdd_cpu";
							};
						};
					};

					smps45 {
						regulator-name = "vdd-gpu";
						regulator-min-microvolt = <0xaae60>;
						regulator-max-microvolt = <0x155cc0>;
						regulator-init-microvolt = <0xf4240>;
