			CC25 {
				iso_abbrev = "EU";
				custom_locale = "E0";
				custom_locale_rev = <0x3e2>;
			};

			CC26 {
				iso_abbrev = "E0";
				custom_locale = "E0";
				custom_locale_rev = <0x3e2>;
			};
		};
	};

	cpu_dfll_board_params {
		sample-rate = <0x30d4>;
		fixed-output-forcing;
		cf = <0x0a>;
		ci = <0x00>;
		cg = <0x02>;
		droop-cut-value = <0x0f>;
		droop-restore-ramp = <0x00>;
		scale-out-ramp = <0x00>;
		linux,phandle = <0x2c>;
		phandle = <0x2c>;
	};

	cpu_dfll_pmic_integration {
		pmic-i2c-address = <0xb0>;
		pmic-i2c-voltage-register = <0x23>;
		i2c-fs-rate = <0x61a80>;
		sel-conversion-slope = <0x01>;
		pmic-undershoot-gb = <0x64>;
		linux,phandle = <0x2d>;
		phandle = <0x2d>;
	};

	dvfs_rails {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		vdd-cpu-rail@2 {
			status = "okay";
			reg = <0x02>;
			compatible = "nvidia,tegra124-dvfs-rail";
			vdd_cpu-supply = <0x81>;
			vmin-cdev = <0x44>;
			vmax-cdev = <0x40>;
		};

		vdd-gpu-rail@3 {
			status = "okay";
			reg = <0x03>;
			compatible = "nvidia,tegra124-dvfs-rail";
			vdd_gpu-supply = <0x82>;
			scaling-cdev = <0x58>;
			vmax-cdev = <0x5e>;
		};

		vdd-core-rail@4 {
			status = "okay";
			reg = <0x04>;
			compatible = "nvidia,tegra124-dvfs-rail";
			vdd_core-supply = <0x83>;
			vmin-cdev = <0x6e>;
			vmax-cdev = <0x70>;
		};

		vdd-cpu-vmin-cdev@5 {
			status = "okay";
			reg = <0x05>;
			cooling-min-state = <0x00>;
			cooling-max-state = <0x01>;
			#cooling-cells = <0x02>;
			compatible = "nvidia,tegra124-rail-vmin-cdev";
			cdev-type = "cpu_cold";
			nvidia,constraint;
			nvidia,trips = <0x43 0x384>;
			linux,phandle = <0x44>;
			phandle = <0x44>;
		};

		vdd-core-vmin-cdev@6 {
			status = "okay";
			reg = <0x06>;
			cooling-min-state = <0x00>;
			cooling-max-state = <0x01>;
			#cooling-cells = <0x02>;
			compatible = "nvidia,tegra124-rail-vmin-cdev";
			cdev-type = "core_cold";
			nvidia,constraint;
			nvidia,trips = <0x6d 0x320>;
			linux,phandle = <0x6e>;
			phandle = <0x6e>;
		};

		vdd-gpu-scaling-cdev@7 {
			status = "okay";
			reg = <0x07>;
			cooling-min-state = <0x00>;
			cooling-max-state = <0x05>;
			#cooling-cells = <0x02>;
			compatible = "nvidia,tegra124-rail-scaling-cdev";
			cdev-type = "gpu_scaling";
			nvidia,constraint;
			nvidia,trips = <0x84 0x3b6 0x57 0x00 0x59 0x00 0x5a 0x00 0x5b 0x00 0x5c 0x00>;
			linux,phandle = <0x58>;
			phandle = <0x58>;
		};

		vdd-cpu-vmax-cdev@8 {
			status = "okay";
			reg = <0x08>;
			cooling-min-state = <0x00>;
			cooling-max-state = <0x01>;
			#cooling-cells = <0x02>;
			compatible = "nvidia,tegra124-rail-vmax-cdev";
			cdev-type = "cpu_hot";
			nvidia,constraint;
			nvidia,trips = <0x3f 0x4ce 0x41 0x4ba 0x42 0x49c>;
			linux,phandle = <0x40>;
			phandle = <0x40>;
		};

		vdd-gpu-vmax-cdev@9 {
			status = "okay";
			reg = <0x09>;
			cooling-min-state = <0x00>;
			cooling-max-state = <0x01>;
			#cooling-cells = <0x02>;
			compatible = "nvidia,tegra124-rail-vmax-cdev";
			cdev-type = "gpu_hot";
			nvidia,constraint;
			nvidia,trips = <0x5d 0x4b0>;
			linux,phandle = <0x5e>;
			phandle = <0x5e>;
		};

		vdd-core-vmax-cdev@10 {
			status = "okay";
			reg = <0x0a>;
			cooling-min-state = <0x00>;
			cooling-max-state = <0x01>;
			#cooling-cells = <0x02>;
			compatible = "nvidia,tegra124-rail-vmax-cdev";
			cdev-type = "core_hot";
			nvidia,constraint;
			nvidia,trips = <0x6f 0x46a 0x71 0x44c 0x72 0x424>;
			linux,phandle = <0x70>;
			phandle = <0x70>;
		};
	};

	dummy-cool-dev {
		compatible = "dummy-cooling-dev";
		#cooling-cells = <0x02>;
		linux,phandle = <0x75>;
		phandle = <0x75>;
	};

	chosen {
		bootargs = "tegraid=40.0.0.00.00 vmalloc=256M vpr_resize video=tegrafb console=ttyS0,115200n8 earlyprintk";
		linux,initrd-start = <0x85000000>;
		linux,initrd-end = <0x851bc400>;
	};

	firmware {

		android {
			compatible = "android,firmware";
			hardware = "tn8";
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		button_led {
			label = "button-backlight";
			pwms = <0x85 0x01 0x2710>;
			max-brightness = <0x64>;
			max-duty = <0x32>;
		};
	};

	hdmi {
		status = "disabled";
	};
};
