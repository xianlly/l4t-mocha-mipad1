	watchdog@60005100 {
		compatible = "nvidia,tegra-wdt";
		reg = <0x00 0x60005100 0x00 0x20 0x00 0x60005070 0x00 0x08>;
		interrupts = <0x00 0x7b 0x04>;
		nvidia,expiry-count = <0x04>;
