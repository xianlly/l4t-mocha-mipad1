			phandle = <0x15>;

			extcon {
				extcon-name = "palmas-extcon";
				compatible = "ti,palmas-usb";
				ti,wakeup;
				#extcon-cells = <0x01>;
				ti,enable-id-detection;
				ti,enable-vbus-detection;
				linux,phandle = <0x79>;
				phandle = <0x79>;
			};

