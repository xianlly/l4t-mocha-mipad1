	gpio-keys {
		compatible = "gpio-keys";

		power {
			label = "Power";
			gpios = <0x12 0x80 0x01>;
			linux,code = <0x74>;
			gpio-key,wakeup;
		};

		volume_down {
			label = "Volume Down";
			gpios = <0x12 0x87 0x01>;
			linux,code = <0x72>;
		};

		volume_up {
			label = "Volume Up";
			gpios = <0x12 0x86 0x01>;
			linux,code = <0x73>;
		};

		hall_intr1 {
			label = "lid_back";
			gpios = <0x12 0xb3 0x01>;
			linux,code = <0x12>;
			linux,input-type = <0x05>;
			gpio-key,wakeup;
		};

		hall_intr2 {
			label = "lid_front";
			gpios = <0x12 0x45 0x01>;
			linux,code = <0x00>;
			linux,input-type = <0x05>;
			gpio-key,wakeup;
		};
	};

