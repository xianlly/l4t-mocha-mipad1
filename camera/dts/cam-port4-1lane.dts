	clocks {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";

		clock {
			compatible = "fixed-clock";
			reg = <0x00>;
			#clock-cells = <0x00>;
			clock-frequency = <0x8000>;
			linux,phandle = <0x1a>;
			phandle = <0x1a>;
		};
	};

	timer@60005000 {
