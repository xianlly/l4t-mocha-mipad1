/dts-v1/;

/ {
	compatible = "nvidia,tn8", "nvidia,tegra124";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	nvidia,dtbbuildtime = "Feb  4 2019", "14:12:42";
	model = "NVIDIA Tegra124 TN8";
	nvidia,dtsfilename = "arch/arm/boot/dts/tegra124-mocha.dts";
	nvidia,boardids = "1780:1100:3:A:7", "1845:1000:0:A:7";

	aliases {
		ehci0 = "/ehci@7d000000";
		ehci1 = "/ehci@7d004000";
		ehci2 = "/ehci@7d008000";
		i2c0 = "/i2c@7000c000";
		i2c1 = "/i2c@7000c400";
		i2c2 = "/i2c@7000c500";
		i2c3 = "/i2c@7000c700";
		i2c4 = "/i2c@7000d000";
		i2c5 = "/i2c@7000d100";
		serial0 = "/serial@70006000";
		serial1 = "/serial@70006040";
		serial2 = "/serial@70006200";
		serial3 = "/serial@70006300";
		spi0 = "/spi@7000d400";
		spi1 = "/spi@7000d600";
		spi2 = "/spi@7000d800";
		spi3 = "/spi@7000da00";
		spi4 = "/spi@7000dc00";
		spi5 = "/spi@7000de00";
		udc0 = "/udc@7d000000";
		rtc1 = "/rtc";
		sdhci0 = "/sdhci@700b0000";
		sdhci2 = "/sdhci@700b0400";
		sdhci3 = "/sdhci@700b0600";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		iram-carveout {
			compatible = "nvidia,iram-carveout";
			reg = <0x00 0x40001000 0x00 0x3f000>;
			no-map;
			linux,phandle = <0x0f>;
			phandle = <0x0f>;
		};
	};

	mc-clk-pd {
		compatible = "nvidia,tegra124-mc-clk-pd";
		#power-domain-cells = <0x00>;
		linux,phandle = <0x02>;
		phandle = <0x02>;
	};

	nvavp-pd {
		compatible = "nvidia,tegra124-nvavp-pd";
		#power-domain-cells = <0x00>;
		power-domains = <0x02>;
		linux,phandle = <0x23>;
		phandle = <0x23>;
	};

	host1x-pd {
		compatible = "nvidia,tegra124-host1x-pd";
		is_off;
		host1x;
		#power-domain-cells = <0x00>;
		power-domains = <0x02>;
		linux,phandle = <0x03>;
		phandle = <0x03>;
	};

	tsec-pd {
		compatible = "nvidia,tegra124-tsec-pd";
		is_off;
		#power-domain-cells = <0x00>;
		power-domains = <0x03>;
		linux,phandle = <0x22>;
		phandle = <0x22>;
	};

	vic03-pd {
		compatible = "nvidia,tegra124-vic03-pd";
		is_off;
		#power-domain-cells = <0x00>;
		power-domains = <0x03>;
		partition-id = <0x17>;
		linux,phandle = <0x20>;
		phandle = <0x20>;
	};

	msenc-pd {
		compatible = "nvidia,tegra124-msenc-pd";
		is_off;
		#power-domain-cells = <0x00>;
		power-domains = <0x03>;
		partition-id = <0x06>;
