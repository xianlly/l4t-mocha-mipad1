				compatible = "ti,palmas-gpio";
				gpio-controller;
				#gpio-cells = <0x02>;
				ti,enable-boost-bypass;
				v_boost_bypass_gpio = <0x04>;
				linux,phandle = <0x7d>;
				phandle = <0x7d>;
			};

			rtc {
				compatible = "ti,palmas-rtc";
				interrupt-parent = <0x15>;
				interrupts = <0x08 0x00>;
			};

			pinmux {
				compatible = "ti,tps65913-pinctrl";
				pinctrl-names = "default";
				pinctrl-0 = <0x16>;

				pinmux {
					linux,phandle = <0x16>;
					phandle = <0x16>;

					powergood {
						pins = "powergood";
						function = "powergood";
					};

					vac {
						pins = "vac";
						function = "vac";
					};

					pin_gpio0 {
						pins = "gpio0";
						function = "id";
						bias-pull-up;
					};

					pin_gpio1 {
						pins = "gpio1";
						function = "gpio";
					};

					pin_gpio6 {
						pins = "gpio2", "gpio3", "gpio4", "gpio6", "gpio7";
						function = "gpio";
					};

					pin_gpio5 {
						pins = "gpio5";
						function = "clk32kgaudio";
					};
				};
			};

			power_pm {
				compatible = "ti,palmas-pm";
				system-pmic-power-reset;
			};

			gpadc {
				compatible = "ti,palmas-gpadc";
				interrupt-parent = <0x15>;
				interrupts = <0x12 0x00 0x10 0x00 0x11 0x00>;
				ti,channel0-current-microamp = <0x14>;

				iio_map {

					ch1 {
						ti,adc-channel-number = <0x01>;
						ti,adc-consumer-device = "generic-adc-thermal.0";
						ti,adc-consumer-channel = "battery-temp-channel";
