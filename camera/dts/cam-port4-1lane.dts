				ldo2-in-supply = <0x17>;
				ldo3-in-supply = <0x18>;
				ldo5-in-supply = <0x13>;
				ldo6-in-supply = <0x19>;
				ldo7-in-supply = <0x19>;
				ldo9-in-supply = <0x19>;
				ldoln-in-supply = <0x18>;
				smps10-out2-supply = <0x18>;

